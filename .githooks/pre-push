#!/usr/bin/env bash
# 推送门禁：调用 scripts/gate.sh（在干净 clone 里跑与 CI 等价的全部门禁）。
#
# 门禁逻辑都在 scripts/gate.sh —— 这里只做一件事：拦住推送。
# 手动提前跑同一条命令：`npm run gate`（或 bash scripts/gate.sh）。
#
# 紧急绕过：git push --no-verify（按 AGENTS.md 门禁规则，须先说明理由并获同意）。
set -euo pipefail

# git push 逐行喂给 stdin：`<local-ref> <local-sha> <remote-ref> <remote-sha>`。
# 取 **remote-ref** 认分支：local-ref 在 `HEAD:<分支>` 写法下是字面量 `HEAD`，
# 只扫第一个 token 会认不出分支（2026-11-13 事故：游离工作树推 HEAD:<分支> 被
# 「'HEAD' is not a valid branch name」拦死）。local-sha 即待测提交，交给门禁精确复现。
push_branch=""
push_sha=""
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/*)
      push_branch="${remote_ref#refs/heads/}"
      push_sha="$local_sha"
      break
      ;;
  esac
done || true

# 分支删除（local-sha 全零，形如 `(delete) 000...`）：没有内容可测，放行；
# 本次推送不含分支引用（如仅推 tag）同理。
if [ -z "$push_branch" ] || [ "$push_sha" = "0000000000000000000000000000000000000000" ]; then
  exit 0
fi

# linked worktree 里 hook 仍来自主工作树的 .githooks；必须用当前工作树解析仓库根，
# 否则门禁会去测主工作树而不是当前分支。
repo_root=$(git rev-parse --show-toplevel)

cd "$repo_root"
if ! bash scripts/gate.sh --quiet "$push_branch" "$push_sha"; then
  echo "[pre-push] 门禁未通过，推送已拦截（手动复现：npm run gate；绕过需先获同意：--no-verify）" >&2
  exit 1
fi
