# 依赖与构建产物
node_modules/
dist/
# 例外：plugins/ 下的 dist 是插件手写源码（无构建步骤），随包分发，不是构建产物
!plugins/*/dist/
# 发布包里的许可证副本（由 packages/cli 的 prepack 从仓库根复制，属构建产物）
packages/cli/LICENSE

# 桌面壳构建 payload（打包时生成）与用户便携数据（凭据，绝不入库）
desktop/app/
desktop/data/

# agent 运行时状态（本机私有）
.box-agent/
.box-agent-scratch/
.commandcode/
# mimosa 安全扫描的钩子状态与封印产物（138MB 级，本机私有）
.mimosa/

# 逆向研究残留目录（catpaw 的本机数据目录副本；研究代码不入库，结论入 docs）
.meituan-catpaw/

# 日志与临时文件
*.log
.tmp/

# Python 遗留（改造为 TypeScript 之前的 venv / 缓存）
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
*.tsbuildinfo

# ZCode 工具自动生成（每次可能重写），不入库
.zcodeignore

# 规划过程文件（planning-with-files；结项即删）
.planning/

# plan-with-files 插件的过程文件：每次会话固定写到仓库根（插件无落点配置），
# 由 verify-docs 经 gitignore 跳过（过程文件不入库、不按文档规则校验）
/task_plan.md
/findings.md
/progress.md

# ZCode 会话产物（计划/exec 缓存等），不入库
.zcode/
.claude/

# DSH 自带工作树落 .agents/worktrees/（.agents/skills 是入库资产，只忽略工作树）
.agents/worktrees/

# 浏览器自动化产物（playwright MCP：截图 / 快照 / console 日志）
.playwright-mcp/

# 编辑器与 IDE
.idea/
.vscode/
*.swp
*.swo

# 操作系统产物
.DS_Store
Thumbs.db
desktop.ini

# 本地环境变量（禁止入库；需要时用 .env.example 提供模板）
.env
.env.*
!.env.example

# 测试与工具缓存
coverage/
.nyc_output/
.cache/
.eslintcache
.pnpm-store/

# 打包与备份残留
*.tgz
*.orig
*.rej
*.bak
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# 外部工具在 cwd 留下的标记（video2code 插件会写 .v2c/plugin_root）
.v2c/
.dsh/
