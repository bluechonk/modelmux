{
  "name": "mx-panel",
  "version": "0.4.0",
  "description": "ModelMux 控制台：把网关的 /web/ 完整内嵌进 ZCode 侧栏。",
  "description_i18n": {
    "en": "ModelMux console: the gateway /web/ UI embedded in the ZCode sidebar.",
    "zh-CN": "ModelMux 控制台：把网关 /web/ 完整内嵌进 ZCode 侧栏。"
  },
  "author": {
    "name": "bluechonk"
  },
  "license": "MIT",
  "mcpServers": {
    "mx-panel": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/dist/server.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "ZCODE_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "ui": {
    "surfaces": [
      {
        "id": "mx-panel",
        "title": {
          "zh-CN": "模型网关",
          "en-US": "ModelMux"
        },
        "icon": "sparkles",
        "server": "mx-panel",
        "resourceUri": "ui://mx-panel/panel.html",
        "availability": "session"
      }
    ]
  }
}
