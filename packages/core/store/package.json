{
  "name": "@modelmux/store",
  "private": true,
  "type": "module",
  "description": "账号池存储的服务化适配器（PgPoolStore）：实现 gateway 的 PoolStore 端口，把池状态/凭据/账本落到 PostgreSQL（docs/SAAS-REDESIGN.md S1）。依赖方向 store → gateway，gateway 不反向依赖（共享层 dependencies 为空的红线不破）",
  "engines": {
    "node": ">=22.6"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@modelmux/gateway": "*",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "^18.6.0-beta.19"
  }
}
