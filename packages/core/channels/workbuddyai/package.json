{
  "name": "@modelmux/workbuddyai",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "WorkBuddyAI 的本地 OpenAI Chat Completion 透明代理网关（TypeScript，无窗口，modelmux 渠道）",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "workbuddyai": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "workbuddyai",
    "gateway",
    "openai",
    "proxy",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelmux/gateway": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.2"
  }
}
