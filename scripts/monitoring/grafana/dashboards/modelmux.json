{
  "uid": "modelmux-s4",
  "title": "modelmux 服务形态（S4）",
  "tags": ["modelmux"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "请求时延 p95 / p50",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "modelmux-prom" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(modelmux_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "p50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(modelmux_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx 错误率",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "modelmux-prom" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "err",
          "expr": "sum(rate(modelmux_http_requests_total{code=~\"5..\"}[1m])) / clamp_min(sum(rate(modelmux_http_requests_total[1m])), 0.001)",
          "legendFormat": "5xx 占比"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "租户消耗（USD 累计）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "modelmux-prom" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "refId": "cost",
          "expr": "sum by (tenant) (modelmux_tenant_cost_usd_total)",
          "legendFormat": "{{tenant}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "限流拒绝次数",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "modelmux-prom" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "rl",
          "expr": "sum by (tenant, model) (modelmux_tenant_rate_limited_total)",
          "legendFormat": "{{tenant}}/{{model}}"
        }
      ]
    }
  ]
}
